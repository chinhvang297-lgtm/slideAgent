# Required: Anthropic API Key
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Model selection (default: claude-opus-4-7)
MODEL=claude-opus-4-7

# Optional: Output directory (default: output)
OUTPUT_DIR=output

# Optional: Temp directory (default: temp)
TEMP_DIR=temp

# Optional: Max slides to generate (default: 20)
MAX_SLIDES=20

# Optional: Max layout clusters for template analysis (default: 6)
MAX_LAYOUT_CLUSTERS=6
